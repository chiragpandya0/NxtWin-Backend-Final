[Unit]
Description=NxtWin frontend (Next.js)
After=network.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@/frontend
ExecStart=@NODE@ node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
